{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "colunas_avaliacoes",
  "position": {
    "x": 40,
    "y": 740,
    "width": 1100,
    "height": 200,
    "z": 12000,
    "tabOrder": 12000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_tempo"
                    }
                  },
                  "Property": "ano_mes"
                }
              },
              "queryRef": "dim_tempo.ano_mes",
              "nativeQueryRef": "ano_mes",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Medidas"
                    }
                  },
                  "Property": "Avaliações (3 meses)"
                }
              },
              "queryRef": "_Medidas.Avaliações (3 meses)",
              "nativeQueryRef": "Avaliações (3 meses)"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Avaliações nos últimos 3 meses'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "valueAxis": [
        {
          "properties": {
            "labelDisplayUnits": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            }
          }
        }
      ]
    }
  }
}