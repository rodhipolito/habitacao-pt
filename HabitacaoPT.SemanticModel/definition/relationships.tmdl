relationship fact_para_geografia
	fromColumn: fact_avaliacao.cod_geo
	toColumn: dim_geografia.cod_geo

relationship fact_para_tempo
	fromColumn: fact_avaliacao.mes
	toColumn: dim_tempo.mes

relationship fact_para_tipo
	fromColumn: fact_avaliacao.tipo_construcao
	toColumn: dim_tipo.tipo_construcao

relationship vendas_para_geografia
	fromColumn: fact_vendas.cod_geo
	toColumn: dim_geografia.cod_geo

