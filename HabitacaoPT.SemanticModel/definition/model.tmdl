model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-PT
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["fact_avaliacao","dim_geografia","dim_tempo","dim_tipo","_Medidas","Pasta","fact_vendas"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table fact_avaliacao
ref table dim_geografia
ref table dim_tempo
ref table dim_tipo
ref table param_min_avaliacoes
ref table _Medidas
ref table fact_vendas

ref cultureInfo en-US

