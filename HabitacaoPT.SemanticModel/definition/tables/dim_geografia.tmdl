					Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
					Tipos = Table.TransformColumnTypes(Cabecalho, {{"cod_geo", type text},{"nome_geo", type text},{"nivel", type text},{"cod_nuts3", type text},{"cod_nuts2", type text},{"cod_nuts1", type text},{"nome_nuts3", type text},{"nome_nuts2", type text}}, "en-US")
